(*Задача 2*)
w[t_] := 2 t^2 - Sin[3t - Pi/2] + 4
w'[t]
w''[t]
N[w[E/2], 20]
w[t_] := 2 t^2 - Sin[3 t - Pi/2] + 4;
N[w'''[Sqrt[5]], 20]
Series[w[t], {t, -1, 2}]
Plot[w[t], {t, 0, Pi},
 Epilog -> {Red, Point[{2, w[2]}]}
]
