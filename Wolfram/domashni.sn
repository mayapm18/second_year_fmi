(*Задача 3*)
p[x_]=x^5-5x^4+x^3+39x^2-88x+60;
q[x_]=x^3+4x^2;
Factor[p[x]]
PolynomialQuotient[p[x],q[x],x]
PolynomialRemainder[p[x],q[x],x]
Integrate[p[x]/q[x],x]
NIntegrate[(p[x]-3*ArcCos[x])/(q[x] + Abs[4x-E]),{x,-1, 1}]
g[x_,y_]=p[x+y]Log[x^2+1];
NIntegrate[g[x,y],{x,-Pi,Pi},{y,-Sqrt[Pi^2-x^2],Sqrt[Pi^2-x^2]}]

------------------
(*Задача 4*)
f[x_]=x^6-2x^3-x-1;

N[NSolve[x^6-2x^3-x-1==0, x, Reals],13]

NMinimize[{x^6-2x^3-x-1, -1 <= x <= 2}, x]

а0=(1/(2*Pi)) * NIntegrate[f[x],{x,-Pi, Pi}]
a[n_]:=(1/Pi) *NIntegrate[f[x]*Cos[n*x],{x,-Pi,Pi}]
b[n_]:=(1/Pi) *NIntegrate[f[x]*Sin[n*x],{x,-Pi,Pi}]
t[x_] := a0 + Sum[a[n] Cos[n*x] + b[n] Sin[n*x], {n, 1, 2}]

Plot[{f[x],t[x]},{x, -Pi, Pi}]

fp[x_] := f'[x](*допирателна*)
tangent[x_] := f[1] +fp[1](x-1);
Plot[{f[x],tangent[x]}, {x,-1,2}]